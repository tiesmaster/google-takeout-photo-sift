<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GoogleTakeoutPhotoSift</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- HEIC without the paid HEVC Video Extensions (decision 16). -->
    <PackageReference Include="Magick.NET-Q8-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoogleTakeoutPhotoSift.Core\GoogleTakeoutPhotoSift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoogleTakeoutPhotoSift.App.Tests" />
  </ItemGroup>

</Project>
