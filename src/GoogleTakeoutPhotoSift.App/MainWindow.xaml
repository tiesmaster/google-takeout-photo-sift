<Window x:Class="Tiesmaster.GoogleTakeoutPhotoSift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Takeout Photo Sift"
        Width="1280" Height="800"
        WindowState="Maximized"
        Background="Black"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- A hard shadow keeps the text readable on light photos. -->
        <Style x:Key="Overlay" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="2" Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- s: the albums in review order with their photo counts; the current one stands out. -->
        <Border x:Name="AlbumList" Grid.Row="0" Grid.Column="0" Width="270" Background="#FF0C0C0C"
                BorderBrush="#FF1E1E1E" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock x:Name="AlbumListTitle" DockPanel.Dock="Top" Foreground="#FF9A9A9A" FontFamily="Segoe UI"
                           FontSize="12" FontWeight="SemiBold" Margin="14,12,10,8" />
                <ScrollViewer x:Name="AlbumListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AlbumListItems" />
                </ScrollViewer>
            </DockPanel>
        </Border>

    <Grid x:Name="PhotoArea" Grid.Row="0" Grid.Column="1" Background="Black" ClipToBounds="True">
        <!-- The frame sizes with the photo (after its turn) and marks a WhatsApp photo. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Photo"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="PhotoFrame" BorderBrush="#FF25D366" BorderThickness="6" Visibility="Collapsed"
                    IsHitTestVisible="False" />
        </Grid>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Counter" Style="{StaticResource Overlay}" FontSize="22" />
                <Border x:Name="WhatsAppPill" Background="#FF25D366" CornerRadius="9" Padding="9,1,9,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="WhatsApp" Foreground="#FF0B2E17" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="TotalSize" Style="{StaticResource Overlay}" FontSize="15" Foreground="#BBBBBB" />
            <TextBlock x:Name="Status" Style="{StaticResource Overlay}" FontSize="15" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <TextBlock x:Name="AlbumLine" Style="{StaticResource Overlay}" FontSize="19" HorizontalAlignment="Center" />
            <TextBlock x:Name="Caption" Style="{StaticResource Overlay}" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock x:Name="SubCaption" Style="{StaticResource Overlay}" FontSize="14" HorizontalAlignment="Center"
                       Foreground="#BBBBBB" />
        </StackPanel>

        <!-- The keys that can follow a sequence's first key (g …). -->
        <TextBlock x:Name="KeyHint" Style="{StaticResource Overlay}" FontSize="15"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10" Visibility="Collapsed" />

        <!-- Shown for a moment when the review crosses into another album. -->
        <Border x:Name="AlbumBanner" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#B0000000" CornerRadius="8" Padding="28,14" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="AlbumBannerText" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="34" />
        </Border>

        <!-- i: details of the current photo, on the right; follows the photo while open. -->
        <Border x:Name="InfoPanel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="430" Margin="0,0,14,0"
                Background="#D0101010" CornerRadius="6" Padding="16,12" Visibility="Collapsed">
            <TextBlock x:Name="InfoText" Foreground="#DDDDDD" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- ?: every shortcut, generated from the binding table. -->
        <Border x:Name="HelpOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E8101010" CornerRadius="8" Padding="24,18" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Keyboard shortcuts" Foreground="White" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <StackPanel x:Name="HelpColumns" Orientation="Horizontal" />
                <TextBlock x:Name="HelpFooter" Foreground="#AAAAAA" FontFamily="Segoe UI" FontSize="13" Margin="0,14,0,0"
                           TextWrapping="Wrap" MaxWidth="1100" />
            </StackPanel>
        </Border>

        <!-- g a: the album picker. Type to filter, Up/Down, Enter to jump, Esc to close. -->
        <Border x:Name="PickerOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640"
                Background="#F0101010" CornerRadius="8" Padding="16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Go to album" Foreground="White" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="PickerFilter" FontSize="16" Padding="6,4" Background="#FF202020" Foreground="White"
                         BorderBrush="#FF555555" CaretBrush="White" TextChanged="OnPickerFilterChanged" />
                <ListBox x:Name="PickerList" MaxHeight="520" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         Foreground="#DDDDDD" FontFamily="Segoe UI" FontSize="15"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnPickerDoubleClick" />
            </StackPanel>
        </Border>

        <!-- : or Ctrl+G: go to a photo number. -->
        <Border x:Name="GoToOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                Background="#F0101010" CornerRadius="8" Padding="16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="GoToTitle" Foreground="White" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="GoToBox" FontSize="18" Padding="6,4" Background="#FF202020" Foreground="White"
                         BorderBrush="#FF555555" CaretBrush="White" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Timing" Style="{StaticResource Overlay}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10"
                   FontFamily="Consolas" FontWeight="Normal" FontSize="13" Visibility="Collapsed" />
    </Grid>

        <!-- Thumbnail strip: N photos before and after the current one (t to hide, T for more or fewer). -->
        <Border x:Name="Strip" Grid.Row="1" Grid.ColumnSpan="2" Background="#FF101010" Padding="0,4,0,6">
            <StackPanel x:Name="StripCells" Orientation="Horizontal" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
